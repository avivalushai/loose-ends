# Copy to .env.local for development, and set the same names in Vercel.
# Nothing here has a default: the site refuses to run in production without them.

# --- Clerk (sign-in with Google + GitHub) -----------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Supabase (users + device_links; run supabase/schema.sql first) ---------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # service role: server-side only, never NEXT_PUBLIC_

# --- The public URL of this deployment --------------------------------------
NEXT_PUBLIC_SITE_URL=https://looseends.dev

# --- PostHog, EU region (set in the CLI's environment, not here) ------------
# LOOSE_ENDS_POSTHOG_KEY=phc_...
